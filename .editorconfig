# Keeps Windows-authored files parseable by the Linux pipeline.
# `charset = utf-8` means UTF-8 *without* a BOM (`utf-8-bom` is the other one),
# which is what Snakemake's parser requires.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{Snakefile,*.smk}]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.json]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Data files: never reflow or re-terminate.
[*.{fasta,fa,faa,tsv,csv}]
trim_trailing_whitespace = false
insert_final_newline = false

[Makefile]
indent_style = tab

# Vendored IEDB bundles - leave third-party sources byte-for-byte alone.
[tools/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
